# All optional. Apex runs without any of these: people choose their own model in the app.

# Port for the local server (npm run dev / npm start).
PORT=3000

# Provider used when a request names none. Only "gemini" uses a server key (below).
# ABIDE_DEFAULT_PROVIDER=gemini
# GEMINI_API_KEY=

# Ollama address used when the app sends none (the app normally sends one).
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Lets "Existing code" read private GitHub repos and avoids GitHub's rate limit.
# GITHUB_TOKEN=
